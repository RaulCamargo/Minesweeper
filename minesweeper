import pygame
import random
import time

# Initialize Pygame
pygame.init()

#Constants
#Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
GRAY = (128, 128, 128)
RED = (255, 0, 0)
BLUE = (0, 0, 255)
GREEN = (0, 255, 0)

# Cell size
CELL_WIDTH = 40
CELL_HEIGHT = 40

# Window dimensions and grid size
WINDOW_WIDTH = 600
WINDOW_HEIGHT = 400
window = pygame.display.set_mode((WINDOW_WIDTH, WINDOW_HEIGHT))
pygame.display.set_caption("Minesweeper")

# Difficulty settings
DIFFICULTY_SETTINGS = {
    "Easy": (10, 10, 10),  # (rows, cols, mines)
    "Medium": (16, 16, 40),
    "Hard": (16, 30, 99)
}

# Global variables
grid = []
cell_discovered = []
cell_marked = []
ROWS = 0
COLS = 0
NUM_MINES = 0
playing = False
initial_time = 0
end_time = 0
margin_r = 0
margin_c = 0
victory = False

# Grid management
def create_grid(row, col):
    return [[0 for _ in range(col)] for _ in range(row)]

def place_mines(grid, row, col, num_mines):
    mines_placed = 0
    while mines_placed < num_mines:
        r = random.randint(0, row - 1)
        c = random.randint(0, col - 1)
        if grid[r][c] == 0:
            grid[r][c] = -1
            mines_placed += 1
            for i in range(max(0, r - 1), min(row, r + 2)):
                for j in range(max(0, c - 1), min(col, c + 2)):
                    if grid[i][j] != -1:
                        grid[i][j] += 1

# Drawing and input handling
def draw_grid(grid, row, col):

    window.fill(BLACK)

    for r in range(row):
        for c in range(col):
            rect = pygame.Rect(margin_r + c * CELL_WIDTH, margin_c + r * CELL_HEIGHT, CELL_WIDTH, CELL_HEIGHT)
            if cell_discovered[r][c]:
                pygame.draw.rect(window, WHITE, rect)
                if grid[r][c] == -1:
                    pygame.draw.circle(window, RED, rect.center, CELL_WIDTH // 4)
                elif grid[r][c] > 0:
                    font = pygame.font.Font(None, 24)
                    text = font.render(str(grid[r][c]), True, BLACK)
                    window.blit(text, text.get_rect(center=rect.center))
            else:
                pygame.draw.rect(window, GRAY, rect)
                if cell_marked[r][c]:
                    pygame.draw.line(window, BLUE, rect.topleft, rect.bottomright, 3)
                    pygame.draw.line(window, BLUE, rect.bottomleft, rect.topright, 3)
            pygame.draw.rect(window, BLACK, rect, 1)
    pygame.display.flip()        

# Cell discovery and marking
def discover_cell(grid, row, col, r, c):
    if r < 0 or r >= row or c < 0 or c >= col or cell_discovered[r][c]:
        return
    cell_discovered[r][c] = True

    if grid[r][c] == 0:
        for i in range(max(0, r - 1), min(row, r + 2)):
            for j in range(max(0, c - 1), min(col, c + 2)):
                discover_cell(grid, row, col, i, j)